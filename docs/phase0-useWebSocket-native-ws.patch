+// SockJS 的傳輸協商走普通 HTTP 請求（/ws/info），所以要把 ws:// 轉回 http://。
 function normalizeSockJsUrl(url) {
   if (url.startsWith('ws://')) return `http://${url.slice(5)}`
   if (url.startsWith('wss://')) return `https://${url.slice(6)}`
   return url
 }
 
+// 原生 WebSocket 要的是**相反方向**：http(s):// → ws(s)://，而且必須是絕對 URL。
+//
+// VITE_WS_URL 預設是相對路徑 '/ws'，而瀏覽器對相對路徑 WebSocket 的解析各家行為有差異，
+// 所以一律用 window.location 補上 origin，不要賭。protocol 的判斷要同時認 https: 與 wss:，
+// 否則已經是 wss:// 的網址會被降級成 ws://，在 HTTPS 頁面下會被混合內容政策直接擋掉。
+function toWsUrl(url) {
+  const absolute = new URL(url, window.location.href)
+  absolute.protocol =
+    absolute.protocol === 'https:' || absolute.protocol === 'wss:' ? 'wss:' : 'ws:'
+  return absolute.toString()
+}
